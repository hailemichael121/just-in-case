<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/config_chip_on_light" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#334B5563" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/config_chip_light" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/config_chip_stroke_light" />
        </shape>
    </item>
</selector>