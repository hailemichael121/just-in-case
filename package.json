{
  "name": "just-in-case",
  "private": true,
  "version": "1.1.0",
  "description": "One survival how-to a day — home screen widget, daily notification, quiet reader.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/bump-version.mjs --patch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "sync": "node scripts/sync-content.mjs && node scripts/make-widget-images.mjs",
    "cap:sync": "cap sync android",
    "mobile:build": "npm run sync && npm run build && npx cap sync android",
    "android:assemble": "cd android && ./gradlew assembleDebug",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "android:install": "npm run mobile:build && cd android && ./gradlew installDebug",
    "android:open": "npx cap open android",
    "build:desktop": "npm run mobile:build && cp android/app/build/outputs/apk/debug/app-debug.apk ~/Desktop/Just-In-Case.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource-variable/manrope": "^5.2.7",
    "@fontsource-variable/newsreader": "^5.3.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
